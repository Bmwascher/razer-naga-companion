<UserControl x:Class="NagaBatteryTray.Ui.Dashboard.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    HorizontalAlignment="Right" Width="340">
  <!-- local copy of the stock converter, NOT DesignSystem.xaml's BoolToVis: StaticResource is
       resolved at load and throws when the app dictionaries are not merged, and SettingsView is
       constructed bare in SettingsViewTests. (Every style here is a DynamicResource, which
       resolves lazily and tolerates that.) Converter is not a DP, so it cannot be dynamic. -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="NoteToVis"/>
  </UserControl.Resources>
  <Border Style="{DynamicResource CardBorder}" Margin="0,8,12,12" Background="{DynamicResource App.CanvasBrush}">
    <ui:DynamicScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto"
                            ScrollChanged="OnScrollerScrollChanged" SizeChanged="OnScrollerSizeChanged">
      <!-- Edge fades: a vertical 4-stop gradient masks the top/bottom ~16px of the viewport.
           On the ScrollViewer itself (not the scrolled content) so the mask's bounding box is the
           stable viewport frame, not content that translates underneath it. The two edge stops'
           color (not just offset) is flipped opaque/transparent from code-behind per scroll
           position; the two inner stops stay opaque and only their offsets move with viewport size. -->
      <ui:DynamicScrollViewer.OpacityMask>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop x:Name="FadeTopEdge" Color="White" Offset="0"/>
          <GradientStop x:Name="FadeTopSolid" Color="White" Offset="0"/>
          <GradientStop x:Name="FadeBottomSolid" Color="White" Offset="1"/>
          <GradientStop x:Name="FadeBottomEdge" Color="White" Offset="1"/>
        </LinearGradientBrush>
      </ui:DynamicScrollViewer.OpacityMask>
      <!-- Right margin is the scrollbar's gutter: without it the bar overlays the right-aligned
           toggles/spinners and cuts the theme selection rows (screenshot-confirmed). -->
      <StackPanel Margin="4,4,14,4">
        <DockPanel Margin="0,0,0,10">
          <TextBlock Style="{DynamicResource BodyText}" FontSize="15" FontWeight="SemiBold" Text="Settings"/>
          <ui:Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="✕" Click="OnClose" Padding="8,3"/>
        </DockPanel>

        <TextBlock Style="{DynamicResource CardTitle}" Text="Theme"/>
        <ListBox x:Name="ThemeList" ItemsSource="{Binding ThemeNames}" SelectedItem="{Binding Theme, Mode=TwoWay}"
                 SelectionChanged="OnThemeChanged" Margin="0,4,0,12" BorderThickness="0" Background="Transparent"/>

        <TextBlock Style="{DynamicResource CardTitle}" Text="Tray icon"/>
        <ListBox x:Name="TrayIconStyleList" SelectionChanged="OnTrayIconStyleChanged"
                 Margin="0,4,0,12" BorderThickness="0" Background="Transparent"/>

        <TextBlock Style="{DynamicResource CardTitle}" Text="General"/>
        <DockPanel Margin="0,6">
          <TextBlock Style="{DynamicResource BodyText}" Text="Run at startup" VerticalAlignment="Center"/>
          <ui:ToggleSwitch DockPanel.Dock="Right" HorizontalAlignment="Right"
                           IsChecked="{Binding RunAtStartup, Mode=TwoWay}"
                           Click="OnStartupToggled"/>
        </DockPanel>
        <DockPanel Margin="0,6">
          <TextBlock Style="{DynamicResource BodyText}" Text="Low-battery alert at (%)" VerticalAlignment="Center"/>
          <ui:NumberBox DockPanel.Dock="Right" HorizontalAlignment="Right" MinWidth="110"
                        Value="{Binding LowBatteryThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Minimum="1" Maximum="100" SmallChange="5" MaxDecimalPlaces="0"/>
        </DockPanel>
        <DockPanel Margin="0,6">
          <TextBlock Style="{DynamicResource BodyText}" Text="Notify on low battery" VerticalAlignment="Center"/>
          <ui:ToggleSwitch DockPanel.Dock="Right" HorizontalAlignment="Right"
                           IsChecked="{Binding LowBatteryNotify, Mode=TwoWay}"/>
        </DockPanel>

        <!-- Preferred mouse: the header selector sets this but cannot unset it (it is disabled
             whenever one mouse is reachable — exactly what a preference for a missing mouse leaves
             behind), so this row is where the value is legible and goes back to automatic -->
        <TextBlock Style="{DynamicResource CardTitle}" Text="Mouse" Margin="0,8,0,0"/>
        <DockPanel Margin="0,6,0,0">
          <TextBlock Style="{DynamicResource BodyText}" Text="Preferred mouse" VerticalAlignment="Center"/>
          <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                     Style="{DynamicResource BodyText}" FontWeight="SemiBold"
                     Text="{Binding PreferredMouseLabel}"/>
        </DockPanel>
        <TextBlock Style="{DynamicResource SubtleText}" TextWrapping="Wrap"
                   Text="{Binding MousePreferenceNote}"
                   Visibility="{Binding ShowMousePreferenceNote, Converter={StaticResource NoteToVis}}"/>
        <ui:Button Content="Use automatic" Click="OnUseAutomaticMouse" Margin="0,6,0,0"
                   IsEnabled="{Binding HasMousePreference}"
                   ToolTip="Stop preferring one mouse — the app drives whichever it finds"/>

        <TextBlock Style="{DynamicResource CardTitle}" Text="Battery polling (seconds)" Margin="0,8,0,0"/>
        <DockPanel Margin="0,6">
          <TextBlock Style="{DynamicResource BodyText}" Text="On battery" VerticalAlignment="Center"/>
          <ui:NumberBox DockPanel.Dock="Right" HorizontalAlignment="Right" MinWidth="110"
                        Value="{Binding PollSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Minimum="15" Maximum="3600" SmallChange="15" MaxDecimalPlaces="0"/>
        </DockPanel>
        <DockPanel Margin="0,6">
          <TextBlock Style="{DynamicResource BodyText}" Text="While charging" VerticalAlignment="Center"/>
          <ui:NumberBox DockPanel.Dock="Right" HorizontalAlignment="Right" MinWidth="110"
                        Value="{Binding PollChargingSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Minimum="15" Maximum="3600" SmallChange="15" MaxDecimalPlaces="0"/>
        </DockPanel>

        <TextBlock Style="{DynamicResource CardTitle}" Text="Buttons" Margin="0,8,0,0"/>
        <ui:Button x:Name="ResetAllButton" Content="Reset all to factory" Click="OnResetAll" Margin="0,6,0,0"/>
        <TextBlock x:Name="ResetNote" Style="{DynamicResource SubtleText}" Text="" TextWrapping="Wrap"/>

        <TextBlock Style="{DynamicResource SubtleText}" Margin="0,14,0,0" TextTrimming="CharacterEllipsis"
                   Text="Razer Naga Companion"
                   ToolTip="Razer Naga Companion — github.com/Bmwascher/razer-naga-companion"/>
      </StackPanel>
    </ui:DynamicScrollViewer>
  </Border>
</UserControl>
